<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC102A43"
    android:elevation="8dp"
    android:paddingTop="8dp"
    android:paddingHorizontal="10dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="等待任务"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOverlayActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="AI 生成中..."
        android:textColor="#A9D6FF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvOverlayTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:text="任务"
        android:visibility="gone"
        android:textColor="#D8E6F2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvOverlayDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="4"
        android:text="详情"
        android:textColor="#F5F7FA"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/llOverlayQuickAsk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etOverlayTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="问当前页面..."
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:minLines="2"
            android:textColor="@android:color/white"
            android:textColorHint="#99D8E6F2"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOverlayStart"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="开始"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnOverlayClose"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="关闭"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llOverlayTeaching"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/groupTeachInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etTeachGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="示教目标..."
                android:inputType="textMultiLine"
                android:maxLines="2"
                android:minLines="1"
                android:textColor="@android:color/white"
                android:textColorHint="#99D8E6F2"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etTeachStepNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="这一步做了什么..."
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:minLines="2"
                android:textColor="@android:color/white"
                android:textColorHint="#99D8E6F2"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTeachRecordStep"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="记录"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnTeachEdit"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="操作"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnTeachFinish"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="完成"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnTeachCancel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="取消"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowOverlayActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOverlayConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="已处理"
            android:textAllCaps="false"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOverlayStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
